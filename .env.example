# Snap Caddy Environment Configuration
# =====================================
# Copy this file to .env.local and fill in your values

# ===================
# Required Variables
# ===================

# Replicate API token for SAM segmentation
# Get one at: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=your_replicate_api_token_here

# ===================
# Optional Variables
# ===================

# SAM Model Configuration
# Default: meta/sam-2-hiera-large
# SAM_MODEL_VERSION=meta/sam-2-hiera-large

# OpenSCAD Configuration
# OPENSCAD_PATH=/usr/bin/openscad
# GRIDFINITY_LIB_PATH=/opt/gridfinity_extended_openscad
# OPENSCAD_USE_XVFB=true
# OPENSCAD_TIMEOUT=300000

# File Storage
# TEMP_DIR=/tmp/snap-caddy
# MAX_FILE_SIZE=10485760
# FILE_RETENTION_MS=3600000

# Rate Limiting
# RATE_LIMIT_REQUESTS=10
# RATE_LIMIT_WINDOW=60000

# Feature Flags
# GENERATE_PREVIEWS=false
# ENABLE_ASYNC_GENERATION=false

# ===================
# Redis/Queue Configuration
# ===================
# Redis connection URL (uses non-standard port 6397 to avoid collisions)
# Start Redis with: ./scripts/start-redis.sh
# Or with Docker: docker compose -f docker-compose.redis.yml up -d
# REDIS_URL=redis://localhost:6397

# Queue worker concurrency (number of concurrent STL generation jobs)
# QUEUE_CONCURRENCY=3

# Job timeout in milliseconds (5 minutes default)
# QUEUE_JOB_TIMEOUT=300000

# Maximum retry attempts for failed jobs
# QUEUE_MAX_RETRIES=3

# Cleanup interval for completed/failed jobs in milliseconds (1 hour default)
# QUEUE_CLEANUP_INTERVAL=3600000

# Logging (debug, info, warn, error)
# LOG_LEVEL=info

# Environment
# NODE_ENV=development
